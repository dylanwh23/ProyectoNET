    private async Task IniciarCarrera()
    {
        _guardando = true;
        try
        {
            // 1. Obtener IDs de corredores automáticamente
            var idsCorredores = await Http.GetFromJsonAsync<List<int>>($"api/carreras/{_carreraAIniciar}/participantes-ids");

            if (idsCorredores == null || !idsCorredores.Any())
            {
                await MostrarAlerta("⚠️ No hay participantes inscritos. No se puede iniciar.", "warning");
                _guardando = false;
                return;
            }

            // 2. Armar el DTO (Ya NO enviamos puntos manuales, se envían vacíos o el backend usa el GeoJSON)
            var dto = new IniciarCarreraDto
            {
                IdCarrera = _carreraAIniciar,
                IdCorredores = idsCorredores,
                TotalPuntosDeControl = new() // Lista vacía, ya que el backend usa la Ruta GeoJSON
            };

            // 3. Enviar comando
            var response = await Http.PostAsJsonAsync("carrera/iniciar", dto);

            if (response.IsSuccessStatusCode)
            {
                await MostrarAlerta($"¡Carrera iniciada exitosamente! 🏁", "success");
                CerrarModalIniciar();
                await CargarCarreras();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await MostrarAlerta($"Error al iniciar: {error}", "danger");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error: {ex}");
            await MostrarAlerta($"Error de conexión", "danger");
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task EliminarCarrera(int id)
    {
        // ⭐ CAMBIO: Verificar si JS está disponible
        if (!_componenteRenderizado)
        {
            await MostrarAlerta("Por favor espere a que la página cargue completamente", "warning");
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar esta carrera?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"{_apiCarreras}/api/Carreras/{id}");
            response.EnsureSuccessStatusCode();

            await MostrarAlerta("Carrera eliminada exitosamente", "success");
            await CargarCarreras();
        }
        catch (Exception ex)
        {
            await MostrarAlerta($"Error al eliminar: {ex.Message}", "danger");
        }
    }

    // ⭐ CAMBIO IMPORTANTE: Proteger las llamadas JS
    private async Task MostrarAlerta(string mensaje, string tipo)
    {
        if (!_componenteRenderizado)
        {
            // Si no está renderizado, solo log en consola
            Console.WriteLine($"[{tipo.ToUpper()}] {mensaje}");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("mostrarAlerta", mensaje, tipo);
        }
        catch (InvalidOperationException)
        {
            Console.WriteLine($"[{tipo.ToUpper()}] {mensaje}");
        }
    }

