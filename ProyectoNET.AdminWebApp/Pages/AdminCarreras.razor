    // Método para ver detalle
    private async Task VerDetalle(int id)
    {
        _cargandoDetalle = true;
        _mostrarModalDetalle = true;
        _detalleCarrera = null;

        try
        {
            var url = $"{_apiCarreras}/{id}/detalle";
            _detalleCarrera = await Http.GetFromJsonAsync<DetalleCarreraDto>(url);

            if (_detalleCarrera == null)
            {
                await MostrarAlerta("No se pudo cargar el detalle de la carrera", "danger");
                _mostrarModalDetalle = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al cargar detalle: {ex.Message}");
            await MostrarAlerta($"Error al cargar detalle: {ex.Message}", "danger");
            _mostrarModalDetalle = false;
        }
        finally
        {
            _cargandoDetalle = false;
            StateHasChanged();
        }
    }

    private void CerrarModalDetalle()
    {
        _mostrarModalDetalle = false;
        _detalleCarrera = null;
    }

