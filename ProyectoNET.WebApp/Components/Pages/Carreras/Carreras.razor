@page "/carreras-en-curso"
@using ProyectoNET.Shared
@layout Layout
@code {
}

<div class="container-fluid text-center py-5 hero carreras-curso-hero text-white">
    <h1 class="display-3">🏃‍♂️ Carreras en curso</h1>
    <input type="text" placeholder="Buscar por nombre de carrera..." class="form-control mx-auto w-75" />
</div>

<div class="container carreras-curso-grid">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var carrera in _carreras)
        {
            <div class="col">
                <div class="card carrera-en-curso-card">
                    <div class="position-relative">
                        <div class="ratio ratio-16x9">
                            <img src="@carrera.ImagenPromocional" class="card-img-top" alt="@carrera.Nombre">
                        </div>
                        <span class="badge-en-vivo">En Vivo</span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">@carrera.Nombre</h5>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <strong>📍 Ubicación:</strong>
                                <span>@carrera.Ubicacion</span>
                            </li>

                            <li class="list-group-item d-flex flex-column align-items-start">
                                <strong>📝 Descripción:</strong>
                                <span class="text-truncate mt-1">@carrera.Descripcion</span>
                            </li>
                        </ul>
                    </div>

                    <div class="card-footer">
                        <button class="btn btn-primary">Ver carrera en vivo</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>