@page "/carrera-tiempo-real/{CarreraId}"
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.SignalR.Client
@inherits ProyectoNET.WebApp.Pages.CarreraTiempoReal
@layout Layout
@rendermode InteractiveServer

<PageTitle>Carrera @CarreraId - Tiempo Real</PageTitle>

<div class="container-fluid mt-4">
    @* 🎯 HEADER PRINCIPAL CON BÚSQUEDA *@
    <div class="tiempo-real-header">
        <div class="row align-items-center g-3">
            @* Título y Stats *@
            <div class="col-lg-3">
                <h1 class="carrera-title">
                    <span class="emoji">🏁</span>
                    Carrera @CarreraId
                </h1>
                <div class="d-flex gap-2 mt-2">
                    <span class="stat-badge total">
                        <span class="icon">👥</span>
                        <span>Total: @_runnersState.Count</span>
                    </span>
                    <span class="stat-badge visible">
                        <span class="icon">✓</span>
                        <span>Visibles: @_filteredRunners.Count</span>
                    </span>
                </div>
            </div>

            @* Buscador *@
            <div class="col-lg-3">
                <div class="search-box">
                    <label class="form-label">🔍 Buscar Corredor</label>
                    <div class="search-input-group">
                        <span class="search-icon-left">🏃</span>
                        <input type="number"
                               class="form-control"
                               placeholder="Número de dorsal..."
                               @bind="_searchInputValue"
                               @bind:event="oninput"
                               @onkeyup="OnSearchKeyUp" />
                        @if (_searchedId.HasValue)
                        {
                            <button class="btn-clear-search" type="button" @onclick="ClearSearch" title="Limpiar búsqueda">
                                ✕
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Datos del Corredor Buscado *@
            <div class="col-lg-6">
                @if (_searchedId.HasValue && _runnersState.ContainsKey(_searchedId.Value))
                {
                    var runner = _runnersState[_searchedId.Value];

                    @if (runner.TiempoNeto.TotalSeconds == 0 && runner.Km == 0)
                    {
                        <div class="alert-custom warning" role="alert">
                            <strong>⏳ Corredor #@runner.IdCorredor:</strong> Aún no ha iniciado la carrera.
                        </div>
                    }
                    else
                    {
                        var ritmo = runner.TiempoNeto.TotalHours > 0 ? (runner.Km / runner.TiempoNeto.TotalHours) : 0;
                        var sortedAll = _runnersState.Values.OrderByDescending(r => r.Km).ToList();
                        var runnersRank = sortedAll.IndexOf(runner) + 1;

                        <div class="runner-card-inline">
                            <div class="runner-header-inline">
                                <span class="runner-badge">🏃 #@runner.IdCorredor</span>
                                <span class="position-badge">Posición: @runnersRank/@_runnersState.Count</span>
                            </div>
                            <div class="runner-stats-inline">
                                <div class="stat-inline">
                                    <span class="stat-icon">🏃</span>
                                    <span class="stat-value-inline">@runner.Km.ToString("F2") km</span>
                                </div>
                                <div class="stat-inline">
                                    <span class="stat-icon">⚡</span>
                                    <span class="stat-value-inline">@runner.Velocidad.ToString("F1") km/h</span>
                                </div>
                                <div class="stat-inline">
                                    <span class="stat-icon">📈</span>
                                    <span class="stat-value-inline">@ritmo.ToString("F2") km/h</span>
                                </div>
                                <div class="stat-inline">
                                    <span class="stat-icon">⏱️</span>
                                    <span class="stat-value-inline">@runner.TiempoOficial.ToString(@"hh\:mm\:ss")</span>
                                </div>
                                <div class="stat-inline">
                                    <span class="stat-icon">🔴</span>
                                    <span class="stat-value-inline">@runner.TiempoNeto.ToString(@"hh\:mm\:ss")</span>
                                </div>
                                <div class="stat-inline">
                                    <span class="stat-icon">🎯</span>
                                    <span class="stat-value-inline">CP #@runner.UltimoCheckpoint</span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (_searchedId.HasValue)
                {
                    <div class="alert-custom danger" role="alert">
                        ❌ <strong>Corredor #@_searchedId no encontrado</strong> en esta carrera.
                    </div>
                }
                else
                {
                    <div class="alert-custom info" role="alert">
                        💡 <strong>Ingresa un número de dorsal</strong> para ver la información del corredor en tiempo real.
                    </div>
                }
            </div>
        </div>
    </div>

    @* 🗺️ MAPA Y CLASIFICACIÓN *@
    <div class="row g-4">
        @* Mapa *@
        <div class="col-lg-8">
            <div class="card map-card">
                <div class="card-header">
                    <span>🗺️</span>
                    <span>Mapa en Vivo</span>
                </div>
                <div class="card-body p-0">
                    @if (!_isDataReady)
                    {
                        <div class="map-loading">
                            <div class="map-loading-content">
                                <div class="spinner-modern"></div>
                                <h5 class="text-muted fw-bold mb-2">Cargando ruta de la carrera...</h5>
                                <small class="text-secondary">Esto puede tardar unos segundos si la simulación está iniciando.</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="map-wrapper" style="height: 600px; width: 100%; display: block; position: relative;">
                            <div id="map-container" class="map-container-style" style="height: 100%; width: 100%;"></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Clasificación *@
        <div class="col-lg-4">
            <div class="card leaderboard-card">
                <div class="card-header">
                    <span>🏆</span>
                    <span>Clasificación en Vivo</span>
                </div>
                <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-sm leaderboard-table mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:60px;">Pos</th>
                                <th style="width:70px;">Dorsal</th>
                                <th class="text-end" style="width:80px;">Km</th>
                                <th class="text-end" style="width:90px;">Ritmo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sortedByRitmo = _runnersState.Values
                                .Where(r => r.TiempoNeto.TotalSeconds > 0)
                                .OrderByDescending(r => r.Km / r.TiempoNeto.TotalHours)
                                .ToList();

                                var top3Ritmo = sortedByRitmo.Take(3).ToList();
                                var top10Distancia = _runnersState.Values
                                .OrderByDescending(r => r.Km)
                                .Take(10)
                                .ToList();
                            }

                            @* TOP 3 POR RITMO *@
                            <tr class="table-section-header">
                                <td colspan="4" class="section-ritmo">
                                    🏆 TOP 3 POR RITMO
                                </td>
                            </tr>

                            @foreach (var runner in top3Ritmo)
                            {
                                var ritmo = runner.TiempoNeto.TotalHours > 0 ? (runner.Km / runner.TiempoNeto.TotalHours) : 0;
                                var rank = top3Ritmo.IndexOf(runner) + 1;
                                <tr @key="runner.IdCorredor" class="table-warning">
                                    <td class="text-center">
                                        <span class="position-with-crown">
                                            <strong>@rank</strong>
                                            @if (rank == 1)
                                            {
                                                <span class="crown-icon">👑</span>
                                            }
                                        </span>
                                    </td>
                                    <td><strong>#@runner.IdCorredor</strong></td>
                                    <td class="text-end">@runner.Km.ToString("F2")</td>
                                    <td class="text-end"><strong>@ritmo.ToString("F1")</strong> km/h</td>
                                </tr>
                            }

                            @* TOP 10 POR DISTANCIA *@
                            <tr class="table-section-header">
                                <td colspan="4" class="section-distancia">
                                    📍 TOP 10 POR DISTANCIA
                                </td>
                            </tr>

                            @foreach (var runner in top10Distancia.Where(r => !top3Ritmo.Contains(r)))
                            {
                                var ritmo = runner.TiempoNeto.TotalHours > 0 ? (runner.Km / runner.TiempoNeto.TotalHours) : 0;
                                var distRank = top10Distancia.IndexOf(runner) + 1;
                                <tr @key="runner.IdCorredor" class="table-info-distancia">
                                    <td class="text-center"><strong>@distRank</strong></td>
                                    <td><strong>#@runner.IdCorredor</strong></td>
                                    <td class="text-end">@runner.Km.ToString("F2")</td>
                                    <td class="text-end"><strong>@ritmo.ToString("F1")</strong> km/h</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>