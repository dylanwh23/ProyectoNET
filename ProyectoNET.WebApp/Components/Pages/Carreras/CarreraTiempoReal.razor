@page "/carrera-tiempo-real/{CarreraId}"
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.SignalR.Client
@inherits ProyectoNET.WebApp.Pages.CarreraTiempoReal
@layout Layout
@rendermode InteractiveServer

<PageTitle>Carrera @CarreraId</PageTitle>

<div class="container-fluid mt-3">
    @* 🔍 BARRA SUPERIOR CON BÚSQUEDA Y DATOS DEL CORREDOR *@
    <div class="row mb-3 align-items-stretch bg-light p-2 rounded border shadow-sm">
        <div class="col-md-3">
            <h3 class="m-0 text-primary">🏁 Carrera: @CarreraId</h3>
            <div class="d-flex gap-2 mt-1">
                <span class="badge bg-secondary">Total: @_runnersState.Count</span>
                <span class="badge bg-success">Visibles: @_filteredRunners.Count</span>
            </div>
        </div>
        
        <div class="col-md-3">
            <label class="form-label text-muted small mb-1">🔍 Buscar Corredor</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🏃</span>
                <input type="number" 
                       class="form-control border-start-0" 
                       placeholder="Dorsal..."
                       @bind="_searchInputValue"
                       @bind:event="oninput"
                       @onkeyup="OnSearchKeyUp" />
                @if (_searchedId.HasValue)
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                        ✕
                    </button>
                }
            </div>
        </div>

        @* 📊 DATOS DEL CORREDOR BUSCADO (INLINE) *@
        <div class="col-md-6">
            @if (_searchedId.HasValue && _runnersState.ContainsKey(_searchedId.Value))
            {
                var runner = _runnersState[_searchedId.Value];
                
                @if (runner.TiempoNeto.TotalSeconds == 0 && runner.Km == 0)
                {
                    <div class="alert alert-warning mb-0 py-2" role="alert">
                        <small><strong>⏳ Corredor #@runner.IdCorredor:</strong> Aún no ha iniciado la carrera.</small>
                    </div>
                }
                else
                {
                    var ritmo = runner.TiempoNeto.TotalHours > 0 ? (runner.Km / runner.TiempoNeto.TotalHours) : 0;
                    var sortedAll = _runnersState.Values.OrderByDescending(r => r.Km).ToList();
                    var runnersRank = sortedAll.IndexOf(runner) + 1;
                    
                    <div class="runner-card-inline">
                        <div class="runner-header-inline">
                            <span class="runner-badge">🏃 #@runner.IdCorredor</span>
                            <span class="position-badge">Pos: @runnersRank/@_runnersState.Count</span>
                        </div>
                        <div class="runner-stats-inline">
                            <div class="stat-inline">
                                <span class="stat-icon">🏃</span>
                                <span class="stat-value-inline">@runner.Km.ToString("F2") km</span>
                            </div>
                            <div class="stat-inline">
                                <span class="stat-icon">⚡</span>
                                <span class="stat-value-inline">@runner.Velocidad.ToString("F1") km/h</span>
                            </div>
                            <div class="stat-inline">
                                <span class="stat-icon">📈</span>
                                <span class="stat-value-inline">@ritmo.ToString("F2") km/h</span>
                            </div>
                            <div class="stat-inline">
                                <span class="stat-icon">⏱️</span>
                                <span class="stat-value-inline">@runner.TiempoOficial.ToString(@"hh\:mm\:ss")</span>
                            </div>
                            <div class="stat-inline">
                                <span class="stat-icon">🔴</span>
                                <span class="stat-value-inline">@runner.TiempoNeto.ToString(@"hh\:mm\:ss")</span>
                            </div>
                            <div class="stat-inline">
                                <span class="stat-icon">🎯</span>
                                <span class="stat-value-inline">CP #@runner.UltimoCheckpoint</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (_searchedId.HasValue)
            {
                <div class="alert alert-danger mb-0 py-2" role="alert">
                    <small>❌ Corredor #@_searchedId no encontrado en la carrera.</small>
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-0 py-2" role="alert">
                    <small class="text-muted">💡 Ingresa un dorsal para ver información del corredor</small>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-3">
            <div class="card shadow">
                <div class="card-body p-0">
                    @if (!_isDataReady)
                    {
                        <div class="d-flex justify-content-center align-items-center"
                            style="height: 600px; background-color: #f8f9fa;">
                            <div class="text-center">
                                <div class="spinner-border text-primary mb-3" role="status"
                                    style="width: 3rem; height: 3rem;"></div>
                                <h5 class="text-muted">Esperando ruta de la carrera...</h5>
                                <small class="text-secondary">Esto puede tardar si la simulación está iniciando.</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="map-wrapper" style="height: 600px; width: 100%; display: block;">
                            <div id="map-container" class="map-container-style"></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @* TABLA DE CLASIFICACIÓN *@
            <div class="card shadow">
                <div class="card-header bg-primary text-white fw-bold">
                    🏆 Clasificación en Vivo
                </div>
                <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-sm mb-0">
                        <thead class="table-light sticky-top" style="top:0; z-index:10;">
                            <tr>
                                <th class="text-center" style="width:50px;">Pos</th>
                                <th style="width:60px;">Dorsal</th>
                                <th style="width:70px;">Km</th>
                                <th style="width:80px;">Ritmo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sortedByRitmo = _runnersState.Values
                                    .Where(r => r.TiempoNeto.TotalSeconds > 0)
                                    .OrderByDescending(r => r.Km / r.TiempoNeto.TotalHours)
                                    .ToList();
                                
                                var top3Ritmo = sortedByRitmo.Take(3).ToList();
                                var top10Distancia = _runnersState.Values
                                    .OrderByDescending(r => r.Km)
                                    .Take(10)
                                    .ToList();
                            }

                            @* TOP 3 POR RITMO *@
                            <tr class="table-section-header">
                                <td colspan="4" class="bg-warning text-dark fw-bold small" style="padding: 6px;">
                                    🏆 TOP 3 POR RITMO
                                </td>
                            </tr>

                            @foreach (var runner in top3Ritmo)
                            {
                                var ritmo = runner.TiempoNeto.TotalHours > 0 ? (runner.Km / runner.TiempoNeto.TotalHours) : 0;
                                var rank = top3Ritmo.IndexOf(runner) + 1;
                                <tr @key="runner.IdCorredor" class="table-warning">
                                    <td class="text-center"><strong>@rank</strong> @(rank == 1 ? "👑" : "")</td>
                                    <td><strong>#@runner.IdCorredor</strong></td>
                                    <td>@runner.Km.ToString("F2")</td>
                                    <td>@ritmo.ToString("F1") km/h</td>
                                </tr>
                            }

                            @* TOP 10 POR DISTANCIA *@
                            <tr class="table-section-header">
                                <td colspan="4" class="bg-info text-white fw-bold small" style="padding: 6px;">
                                    📍 TOP 10 POR DISTANCIA
                                </td>
                            </tr>

                            @foreach (var runner in top10Distancia.Where(r => !top3Ritmo.Contains(r)))
                            {
                                var ritmo = runner.TiempoNeto.TotalHours > 0 ? (runner.Km / runner.TiempoNeto.TotalHours) : 0;
                                var distRank = top10Distancia.IndexOf(runner) + 1;
                                <tr @key="runner.IdCorredor" class="table-info-distancia">
                                    <td class="text-center"><strong>@distRank</strong></td>
                                    <td><strong>#@runner.IdCorredor</strong></td>
                                    <td>@runner.Km.ToString("F2")</td>
                                    <td>@ritmo.ToString("F1") km/h</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>