@page "/carreras-disponibles"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using ProyectoNET.Shared
@using ProyectoNET.WebApp.Models
@layout Layout

@code {
    // Tu código C# aquí

    private double CalcularPorcentajeCupos(int actuales, int maximos)
    {
        return maximos > 0 ? ((double)actuales / maximos) * 100 : 0;
    }

    private string GetCuposClass(double porcentaje)
    {
        if (porcentaje >= 80) return "danger";
        if (porcentaje >= 60) return "warning";
        return "";
    }

    private string GetBadgeClass(int actuales, int maximos)
    {
        var porcentaje = CalcularPorcentajeCupos(actuales, maximos);
        if (porcentaje >= 90) return "badge-cupos-limitados";
        if (porcentaje >= 50) return "badge-disponible";
        return "badge-proximo";
    }

    private string GetBadgeText(int actuales, int maximos)
    {
        var porcentaje = CalcularPorcentajeCupos(actuales, maximos);
        if (porcentaje >= 90) return "¡Últimos Cupos!";
        if (porcentaje >= 50) return "Disponible";
        return "Muchos Cupos";
    }
}

<!-- Hero Section -->
<div class="carreras-hero text-center text-white">
    <h1>Carreras Disponibles 2026</h1>
    <div class="search-container">
        <input type="text"
               placeholder="Buscar por nombre, ubicación o fecha..."
               class="form-control search-input" />
        <i class="fas fa-search search-icon"></i>
    </div>
</div>



<!-- Grid de Carreras -->
<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var carrera in _carreras)
        {
            var porcentajeCupos = CalcularPorcentajeCupos(carrera.CantidadParticipantes, carrera.CantidadMaximaParticipantes);

            <div class="col">
                <div class="carrera-card-disponible">
                    <!-- Imagen con Badge -->
                    <div class="card-img-wrapper">
                        @if (!string.IsNullOrEmpty(carrera.ImagenPromocional))
                        {
                            <img src="@carrera.ImagenPromocional"
                                 class="card-img-top"
                                 alt="@carrera.Nombre"
                                 loading="lazy"
                                 onerror="this.style.display='none'">
                        }
                        <span class="carrera-badge @GetBadgeClass(carrera.CantidadParticipantes, carrera.CantidadMaximaParticipantes)">
                            @GetBadgeText(carrera.CantidadParticipantes, carrera.CantidadMaximaParticipantes)
                        </span>
                    </div>

                    <!-- Contenido de la Tarjeta -->
                    <div class="card-body p-4">
                        <h5 class="card-title">@carrera.Nombre</h5>

                        <!-- Información Organizada -->
                        <ul class="info-list">
                            <!-- Descripción -->
                            <li class="info-item">
                                <div class="info-icon">
                                    <i class="fas fa-info-circle"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Descripción</div>
                                    <div class="carrera-descripcion">
                                        @carrera.Descripcion
                                    </div>
                                </div>
                            </li>

                            <!-- Ubicación -->
                            <li class="info-item">
                                <div class="info-icon">
                                    <i class="fas fa-map-marker-alt"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Ubicación</div>
                                    <div class="info-value">@carrera.Ubicacion</div>
                                </div>
                            </li>

                            <!-- Fecha -->
                            <li class="info-item">
                                <div class="info-icon">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Fecha</div>
                                    <div class="info-value">@carrera.FechaInicio.ToString("dd/MM/yyyy")</div>
                                </div>
                            </li>

                            <!-- Precio -->
                            <li class="info-item">
                                <div class="info-icon">
                                    <i class="fas fa-ticket-alt"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Inversión</div>
                                    <div class="info-value info-value-large">@carrera.CostoInscripcion.ToString("C")</div>
                                </div>
                            </li>

                            <!-- Cupos con barra de progreso -->
                            <li class="info-item">
                                <div class="info-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Cupos Disponibles</div>
                                    <div class="info-value mb-2">
                                        @carrera.CantidadParticipantes / @carrera.CantidadMaximaParticipantes
                                    </div>
                                    <div class="cupos-bar">
                                        <div class="cupos-progress @GetCuposClass(porcentajeCupos)"
                                             style="width: @porcentajeCupos.ToString("F0")%">
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Botón de Inscripción -->
                    <button class="btn-inscribir-carrera" @onclick='(() => ReiniciarFormulario(carrera.Id))' data-bs-toggle="modal" data-bs-target="#inscripcionModal">
                        <i class="fas fa-bolt"></i>
                        <span>Inscribirme Ahora</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Empty State (si no hay carreras) -->
@if (_carreras == null || !_carreras.Any())
{
    <div class="container">
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-search"></i>
            </div>
            <h3>No hay carreras disponibles</h3>
            <p>Vuelve pronto para ver nuevos eventos.</p>
        </div>
    </div>
}

<!-- Modal de Inscripción -->
<div class="modal fade" id="inscripcionModal" tabindex="-1" aria-labelledby="inscripcionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="inscripcionModalLabel">Inscribirse a Carrera</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success" role="alert">
                        @mensajeExito
                        @if (!string.IsNullOrEmpty(passwordGenerada))
                        {
                            <p>Tu contraseña generada es: <strong>@passwordGenerada</strong>. ¡Guárdala bien!</p>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger" role="alert">
                        @mensajeError
                    </div>
                }
                <EditForm Model="@inscripcionModel" OnValidSubmit="ProcesarInscripcion" FormName="inscripcionForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre</label>
                        <InputText id="nombre" class="form-control" @bind-Value="inscripcionModel.Nombre" />
                        <ValidationMessage For="@(() => inscripcionModel.Nombre)" />
                    </div>
                    <div class="mb-3">
                        <label for="apellido" class="form-label">Apellido</label>
                        <InputText id="apellido" class="form-control" @bind-Value="inscripcionModel.Apellido" />
                        <ValidationMessage For="@(() => inscripcionModel.Apellido)" />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <InputText id="email" class="form-control" @bind-Value="inscripcionModel.Email" />
                        <ValidationMessage For="@(() => inscripcionModel.Email)" />
                    </div>
                    <div class="mb-3">
                        <label for="fechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                        <InputDate id="fechaNacimiento" class="form-control" @bind-Value="inscripcionModel.FechaNacimiento" />
                        <ValidationMessage For="@(() => inscripcionModel.FechaNacimiento)" />
                    </div>
                    <div class="mb-3">
                        <label for="lugarDeEntrega" class="form-label">Lugar de Entrega</label>
                        <InputNumber id="lugarDeEntrega" class="form-control" @bind-Value="inscripcionModel.LugarDeEntregaId" />
                        <ValidationMessage For="@(() => inscripcionModel.LugarDeEntregaId)" />
                    </div>
                     <div class="d-grid">
                        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Procesando...</span>
                            }
                            else
                            {
                                <span>Inscribirme</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CerrarModal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
